# 自建错误收集服务地址（可选）
# 本地部署：http://localhost:3000
# Cloudflare Workers：https://seahi-error-server.your-subdomain.workers.dev
ERROR_SERVER_URL=https://seahi-error-server.your-subdomain.workers.dev

# 上报接口鉴权 Key（强烈建议设置）
# 未设置时：node 版服务端只接受本机(127.0.0.1)请求；Cloudflare Worker 版直接 401（公网必须设置）
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# 客户端通过同名环境变量 ERROR_API_KEY 带上，需与服务端一致
ERROR_API_KEY=

# 每 IP 每分钟请求上限（仅 node 版，可选，默认 60）
RATE_LIMIT_PER_MIN=60

# Sentry DSN - 从 Sentry 项目设置中获取（可选）
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# GitHub Token - 用于创建 Issue（可选，备用方案）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=owner/repo

# 环境
RUST_ENV=production
