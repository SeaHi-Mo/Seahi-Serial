[
  {
    "id": "tab_at",
    "type": "tab",
    "label": "AT 指令测试",
    "disabled": false,
    "info": "画布负责编排：触发 → 跑指令集 → 按结果分流。指令本身在节点对话框里填表。"
  },
  {
    "id": "inj_manual",
    "type": "inject",
    "z": "tab_at",
    "name": "手动跑",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 160,
    "y": 120,
    "wires": [["at_smoke"]]
  },
  {
    "id": "at_smoke",
    "type": "at-suite",
    "z": "tab_at",
    "name": "冒烟三条",
    "port": "COM5",
    "baud": "115200",
    "eol": "crlf",
    "verbose": true,
    "steps": [
      {
        "on": true,
        "name": "连通性",
        "cmd": "AT",
        "expect": "OK",
        "mode": "contains",
        "timeout": 3000,
        "fail": "retry",
        "retry": 3
      },
      {
        "on": true,
        "name": "版本",
        "cmd": "AT+GMR",
        "expect": "\\+GMR:",
        "mode": "regex",
        "timeout": 5000,
        "fail": "abort",
        "retry": 3
      },
      {
        "on": true,
        "name": "不应出现错误",
        "cmd": "AT+CWMODE?",
        "expect": "ERROR",
        "mode": "absent",
        "timeout": 2000,
        "fail": "continue",
        "retry": 1
      }
    ],
    "x": 380,
    "y": 120,
    "wires": [["sw_pass"], ["dbg_failed"]]
  },
  {
    "id": "sw_pass",
    "type": "switch",
    "z": "tab_at",
    "name": "整套通过？",
    "property": "payload.pass",
    "propertyType": "msg",
    "rules": [{ "t": "true" }, { "t": "else" }],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 620,
    "y": 100,
    "wires": [["dbg_pass"], ["dbg_failed2"]]
  },
  {
    "id": "dbg_pass",
    "type": "debug",
    "z": "tab_at",
    "name": "通过：汇总",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 830,
    "y": 80,
    "wires": []
  },
  {
    "id": "dbg_failed2",
    "type": "debug",
    "z": "tab_at",
    "name": "未通过：汇总",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 840,
    "y": 120,
    "wires": []
  },
  {
    "id": "dbg_failed",
    "type": "debug",
    "z": "tab_at",
    "name": "失败明细",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 620,
    "y": 180,
    "wires": []
  }
]
