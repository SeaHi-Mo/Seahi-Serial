[
  {
    "id": "flow_rx_tab",
    "type": "tab",
    "label": "接收并分支",
    "disabled": false,
    "info": ""
  },
  {
    "id": "flow_rx_rxd",
    "type": "serial rxd",
    "z": "flow_rx_tab",
    "name": "接收应答",
    "monitor": "main",
    "format": "text",
    "pollMs": 100,
    "x": 140,
    "y": 140,
    "wires": [["flow_rx_switch"]]
  },
  {
    "id": "flow_rx_switch",
    "type": "switch",
    "z": "flow_rx_tab",
    "name": "OK / ERROR",
    "property": "payload",
    "propertyType": "msg",
    "rules": [
      { "t": "cont", "v": "OK", "vt": "str" },
      { "t": "cont", "v": "ERROR", "vt": "str" }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 2,
    "x": 370,
    "y": 140,
    "wires": [["flow_rx_set_ok"], ["flow_rx_set_err"]]
  },
  {
    "id": "flow_rx_set_ok",
    "type": "change",
    "z": "flow_rx_tab",
    "name": "成功：发下一条",
    "rules": [
      { "t": "set", "p": "payload", "pt": "msg", "to": "AT+NEXT", "tot": "str" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 600,
    "y": 100,
    "wires": [["flow_rx_txd_ok"]]
  },
  {
    "id": "flow_rx_set_err",
    "type": "change",
    "z": "flow_rx_tab",
    "name": "失败：重发",
    "rules": [
      { "t": "set", "p": "payload", "pt": "msg", "to": "AT+RETRY", "tot": "str" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 590,
    "y": 180,
    "wires": [["flow_rx_txd_err"]]
  },
  {
    "id": "flow_rx_txd_ok",
    "type": "serial txd",
    "z": "flow_rx_tab",
    "name": "发送下一条",
    "monitor": "main",
    "format": "text",
    "eol": "crlf",
    "x": 820,
    "y": 100,
    "wires": [[]]
  },
  {
    "id": "flow_rx_txd_err",
    "type": "serial txd",
    "z": "flow_rx_tab",
    "name": "重发",
    "monitor": "main",
    "format": "text",
    "eol": "crlf",
    "x": 810,
    "y": 180,
    "wires": [[]]
  }
]
