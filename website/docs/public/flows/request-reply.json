[
  {
    "id": "flow_rq_tab",
    "type": "tab",
    "label": "请求应答 AT+CSQ",
    "disabled": false,
    "info": ""
  },
  {
    "id": "flow_rq_inject",
    "type": "inject",
    "z": "flow_rq_tab",
    "name": "查询信号",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "AT+CSQ",
    "payloadType": "str",
    "x": 140,
    "y": 140,
    "wires": [["flow_rq_request"]]
  },
  {
    "id": "flow_rq_request",
    "type": "serial request",
    "z": "flow_rq_tab",
    "name": "查询信号",
    "monitor": "main",
    "sendFormat": "text",
    "recvFormat": "text",
    "eol": "crlf",
    "timeoutMs": 1000,
    "quietMs": 80,
    "rules": [
      { "t": "cont", "v": "OK" },
      { "t": "cont", "v": "ERROR" },
      { "t": "timeout", "v": "" }
    ],
    "outputs": 3,
    "x": 390,
    "y": 140,
    "wires": [["flow_rq_ok"], ["flow_rq_err"], ["flow_rq_to"]]
  },
  {
    "id": "flow_rq_ok",
    "type": "debug",
    "z": "flow_rq_tab",
    "name": "OK 分支",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload",
    "statusType": "auto",
    "x": 660,
    "y": 100,
    "wires": []
  },
  {
    "id": "flow_rq_err",
    "type": "debug",
    "z": "flow_rq_tab",
    "name": "ERROR 分支",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload",
    "statusType": "auto",
    "x": 670,
    "y": 160,
    "wires": []
  },
  {
    "id": "flow_rq_to",
    "type": "debug",
    "z": "flow_rq_tab",
    "name": "超时 / 未匹配",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "timedOut",
    "statusType": "auto",
    "x": 690,
    "y": 220,
    "wires": []
  }
]
